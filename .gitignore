# =================================================================
# PawnLogic Project - Git Ignore Configuration
# =================================================================

# --- Sensitive data (core protection) ---
.env
.env.*
!.env.example
*.Key
*.key
*.token
*.pem
*.crt
*.p12
id_rsa*
id_ed25519*
.envrc
mcp_configs.json
custom_providers.smoke.json
secrets.json
secrets.yaml
*.secret

# --- Python environments and caches ---
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.hypothesis/
.nox/
.tox/
.pytype/
.eggs/
pip-wheel-metadata/

# --- AI tool caches and config ---
.aider*
.aiderignore
.cline/
.thought
.pawnlogic_index/
.pawnlogic_eval/
.codex_goals/
.agent-work/

# --- Editors and IDEs (JetBrains/VS Code) ---
.idea/
.vscode/
*.swp
*.bak
*.user
*.code-workspace

# --- Build artifacts and distributions ---
build/
dist/
*.egg-info/
*.spec

# --- Operating system temporary files ---
.DS_Store
Thumbs.db

# --- CI caches ---
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- History and backups (avoid committing filter-repo or manual backups) ---
*.gitbackup-*
*.git-backup-*
.git-rewrite/
*-original/
*.orig
*.rej

# --- Project-specific excludes (logs and temporary data) ---
logs/
*.log
temp/
*.pyc
.claude/
pwn_debug.md
iscc_work/

# --- Local runtime databases (never commit user or test session state) ---
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Agent memory (privacy: may contain user context)
docs/agents/skill-pack-tui.md

# Release staging marker must remain visible and stageable.
!.release-ready
